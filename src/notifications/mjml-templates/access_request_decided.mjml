{% extends "bookended_base.mjml" %}

{% block notification_content %}
<mj-section mj-class="notification-content-section">
    <mj-column>
        <mj-text align="left">
            {% for paragraph in paragraphs %}
            <p>{{ paragraph|e }}</p>
            {% endfor %}
        </mj-text>
        {% if button %}
        <mj-button align="left" href="{{ button.url }}">{{ button.label|e }}</mj-button>
        {% endif %}
    </mj-column>
</mj-section>

<mj-section>
    <mj-column>
        <mj-text align="center" font-size="12px" color="#666666">
            {{ footer|e }}<br>
            {% trans %}Powered by Kausal Watch{% endtrans %}
        </mj-text>
    </mj-column>
</mj-section>
{% endblock %}
